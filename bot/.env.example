# 复制本文件为 bot/.env 并按需修改。真实 .env 已被 .gitignore 排除,不要提交。

# ———————————— NoneBot2 运行配置 ————————————
DRIVER=~fastapi+~websockets    # fastapi 提供反向 WS 服务端
HOST=0.0.0.0                   # 监听所有网卡,容器里的 NapCat 才连得进来
PORT=8080                      # 反向 WS 端口;NapCat 连 ws://host.docker.internal:8080/onebot/v11/ws

# 命令前缀:发 /echo xxx 时的那个 "/"
COMMAND_START=["/", ""]

# 超级用户:填你的**个人** QQ 号(不是机器人号),/cs2 测试 等管理命令才认你
SUPERUSERS=["123456789"]

# ———————————— cs2_results 插件 ————————————
# 全部可配项及默认值见 bot/src/plugins/cs2_results/config.py(小写字段名对应大写键)。

# 预置推送目标群;也可在群里发 /cs2 订阅 动态添加
CS2_SUBSCRIBED_GROUPS=[123456789]

# 调试群:只有这些群(或超管私聊)才能用 /cs2 状态、/cs2 测试,并看到「管理·调试」版帮助卡。
# 普通群完全看不到这些管理功能,/cs2 状态 的订阅信息也不会泄露给普通群。
CS2_DEBUG_GROUPS=[123456789]

# 抓取浏览器模式:false=无头(默认)。HLTV /events 的 Cloudflare 有时会硬挡无头
# ("Attention Required");若持续被挡,可设 true 走有头(窗口自动移到屏幕外,不打扰桌面)。
CS2_HEADFUL=false

# 任意两次 HLTV 请求的最小间隔(秒)。拉大以降低 Cloudflare 命中率(如 120 表示
# 2 分钟内绝不发第二个请求)。代价:直播逐图战报、首次 logo 加载会变慢。
# ⚠️ 请勿调小默认值——高频抓取既容易被 Cloudflare 封禁,也是对 HLTV 的不友好行为。
CS2_REQUEST_MIN_GAP=120

# htmlrender 0.7.x:选 playwright 后端(需先 `playwright install chromium`)
RENDER_BACKEND=playwright
